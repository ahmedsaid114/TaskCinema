<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#080a12" />
    <title>@ViewData["Title"] - falcon.</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/customer/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="ambient ambient-one"></div><div class="ambient ambient-two"></div>
    <header class="site-header">
        <a class="brand" asp-area="Customer" asp-controller="Home" asp-action="Index">falcon<span>.</span></a>
        <button class="menu-toggle" id="menuToggle" aria-label="Toggle navigation"><i></i><i></i></button>
        <nav class="main-nav" id="mainNav">
            <a asp-area="Customer" asp-controller="Home" asp-action="Index">Home</a>
            <a asp-area="Customer" asp-controller="Home" asp-action="Movies">Movies</a>
            <a asp-area="Customer" asp-controller="Home" asp-action="Cinemas">Cinemas</a>
            <a asp-area="Customer" asp-controller="Home" asp-action="About">About</a>
        </nav>
        <a class="header-cta" asp-area="Customer" asp-controller="Home" asp-action="Movies">Explore movies <span>↗</span></a>
    </header>
    <main>@RenderBody()</main>
    <footer class="site-footer">
        <a class="brand" asp-area="Customer" asp-controller="Home" asp-action="Index">falcon<span>.</span></a>
        <p>Your next favorite memory starts here.</p>
        <span class="footer-copy">© @DateTime.Now.Year Falcon Cinemas</span>
    </footer>
    <script src="~/customer/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
