@{ ViewData["Title"] = "Booking confirmed"; var seats = ViewBag.Seats as string[] ?? Array.Empty<string>(); }
<section class="success-wrap section-wrap reveal"><div class="success-icon">✓</div><div class="eyebrow"><span class="eyebrow-line"></span> IT'S A MOVIE NIGHT</div><h1>You're all <em>set.</em></h1><p class="success-copy">Your booking request has been received. This is a frontend demo confirmation; payment and saving reservations to SQL Server will be connected in the backend stage.</p><div class="confirmation-card"><span class="field-label">YOUR SELECTION</span><h2>@(ViewBag.MovieTitle ?? "Your movie")</h2><p>@(ViewBag.ShowDate ?? DateTime.Today.ToString("yyyy-MM-dd")) · @(ViewBag.ShowTime ?? "Showtime selected")</p><p>Seats: @(seats.Length > 0 ? string.Join(", ", seats) : "No seats supplied")</p></div><a class="btn btn-primary" asp-action="Index">Back to home <span>↗</span></a></section>
