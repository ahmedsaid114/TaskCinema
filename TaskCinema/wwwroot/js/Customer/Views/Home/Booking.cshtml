@{ ViewData["Title"] = "Book tickets"; var movieId = (int)(ViewBag.MovieId ?? 1); var title = movieId == 2 ? "The Last Frame" : movieId == 3 ? "Neon Horizon" : movieId == 4 ? "After The Rain" : "Midnight Signal"; }
<section class="page-hero section-wrap reveal"><div class="eyebrow"><span class="eyebrow-line"></span> YOUR MOVIE NIGHT</div><h1>Save your <em>seat.</em></h1><p>Pick a showtime, choose your seats, and you're all set.</p></section>
<section class="section-wrap booking-layout"><form asp-action="Booking" method="post" class="booking-panel reveal"><input type="hidden" name="movieTitle" value="@title"/><label class="field-label">MOVIE</label><div class="selected-movie"><div class="mini-ticket">✦</div><div><strong>@title</strong><small>Premium cinema experience</small></div></div><label class="field-label" for="showDate">SELECT DATE</label><input class="form-control" type="date" id="showDate" name="showDate" required min="@DateTime.Today.ToString("yyyy-MM-dd")" value="@DateTime.Today.ToString("yyyy-MM-dd")"/><label class="field-label">SHOWTIME</label><div class="time-options"><label><input type="radio" name="showTime" value="02:30 PM" checked/><span>02:30 PM</span></label><label><input type="radio" name="showTime" value="05:45 PM"/><span>05:45 PM</span></label><label><input type="radio" name="showTime" value="08:30 PM"/><span>08:30 PM</span></label></div><label class="field-label">CHOOSE YOUR SEATS <small id="seatCount">(0 selected)</small></label><div class="screen-curve"><span>SCREEN</span></div><div class="seat-map" id="seatMap" aria-label="Choose seats"></div><div class="seat-legend"><span><i class="seat-sample"></i> Available</span><span><i class="seat-sample selected"></i> Selected</span><span><i class="seat-sample occupied"></i> Occupied</span></div><div class="booking-total"><div><small>TOTAL ESTIMATE</small><strong id="totalPrice">EGP 0</strong></div><button class="btn btn-primary" type="submit" id="confirmBooking" disabled>Confirm booking <span>↗</span></button></div></form><aside class="booking-aside reveal reveal-delay"><div class="aside-glow">✦</div><span class="eyebrow">THE FALCON PROMISE</span><h2>Your perfect night starts with a single <em>click.</em></h2><p>Choose your favorite seats and get ready for the big-screen experience.</p><div class="aside-feature"><span>✓</span><div><b>Premium comfort</b><small>Designed around you</small></div></div><div class="aside-feature"><span>✓</span><div><b>Crystal-clear sound</b><small>Feel every moment</small></div></div><div class="aside-feature"><span>✓</span><div><b>Easy booking</b><small>Your plans, simplified</small></div></div></aside></section>
@section Scripts { <script>window.initSeatPicker && window.initSeatPicker();</script> }
