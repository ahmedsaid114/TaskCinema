@{ ViewData["Title"] = "Movie details"; var movieId = (int)(ViewBag.MovieId ?? 1); var title = movieId == 2 ? "The Last Frame" : movieId == 3 ? "Neon Horizon" : movieId == 4 ? "After The Rain" : "Midnight Signal"; var genre = movieId == 2 ? "Drama · Mystery" : movieId == 3 ? "Action · Adventure" : movieId == 4 ? "Romance · Drama" : "Sci-Fi · Thriller"; var image = movieId == 2 ? "https://images.unsplash.com/photo-1500530855697-b586d89ba3ee?auto=format&fit=crop&w=1400&q=90" : movieId == 3 ? "https://images.unsplash.com/photo-1519608487953-e999c86e7455?auto=format&fit=crop&w=1400&q=90" : movieId == 4 ? "https://images.unsplash.com/photo-1470252649378-9c29740c9fa8?auto=format&fit=crop&w=1400&q=90" : "https://images.unsplash.com/photo-1518709268805-4e9042af9f23?auto=format&fit=crop&w=1400&q=90"; }
<section class="details-hero section-wrap"><div class="details-poster reveal"><img src="@image" alt="@title"/></div><div class="details-copy reveal reveal-delay"><a class="back-link" asp-action="Movies">← Back to movies</a><div class="eyebrow"><span class="eyebrow-line"></span> FEATURED FILM</div><h1>@title</h1><div class="details-tags"><span>@genre</span><span>2026</span><span>2h 08m</span></div><div class="details-rating"><span>★ 8.9/10</span><small>Audience rating</small></div><p>A gripping cinematic journey filled with unexpected turns, unforgettable characters, and moments that stay with you long after the credits roll.</p><div class="details-actions"><a class="btn btn-primary" asp-action="Booking" asp-route-id="@movieId">Book tickets <span>↗</span></a><span class="availability"><i></i> Now showing</span></div></div></section>
<section class="section-wrap details-info"><div><span class="info-label">THE EXPERIENCE</span><h2>Better on the <em>big screen.</em></h2></div><p>Settle in, switch off the outside world, and let the story take over. Choose your preferred showtime and make it a night to remember.</p></section>
